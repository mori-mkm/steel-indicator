{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(python src/indices_setoriais.py *)",
      "Bash(python -m pip install *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit --amend*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git clean*)",
      "Bash(git filter-branch*)",
      "Bash(rm -rf*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)"
    ]
  }
}
